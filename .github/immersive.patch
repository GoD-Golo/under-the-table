diff --git a/apps/web/src/styles.css b/apps/web/src/styles.css
index e1c7ba3..22e34ba 100644
--- a/apps/web/src/styles.css
+++ b/apps/web/src/styles.css
@@ -424,3 +424,42 @@ button { color: inherit; }
   .play-mobile-dock button.active { color: #f2e4cb; background: rgba(197,156,91,.16); }
   .play-workspace .hud-stage.freeform-mode { overflow-x: auto; }
 }
+
+/* Immersive Virtual Table — browser-clean by default, optional real fullscreen */
+.app-shell.immersive-play { height: 100dvh; min-height: 100dvh; overflow: hidden; }
+.immersive-play .play-workspace, .play-workspace.immersive-table { height: 100dvh; min-height: 0; overflow: hidden; }
+.play-workspace.immersive-table { position: relative; }
+.play-bubble {
+  width: 38px; height: 38px; display: grid; place-items: center; padding: 0;
+  border: 1px solid rgba(255,255,255,.10); border-radius: 999px;
+  background: rgba(7,9,13,.48); color: #d6d2ca; cursor: pointer;
+  box-shadow: 0 8px 24px rgba(0,0,0,.18); backdrop-filter: blur(9px);
+  opacity: .64; transition: opacity 140ms ease, background 140ms ease, border-color 140ms ease, transform 140ms ease;
+}
+.play-bubble:hover, .play-bubble:focus-visible { opacity: 1; background: rgba(7,9,13,.90); border-color: rgba(197,156,91,.34); }
+.play-back-bubble { position: absolute; z-index: 72; top: max(10px, env(safe-area-inset-top)); left: max(10px, env(safe-area-inset-left)); font-size: 18px; }
+.play-utility-bubble { position: absolute; z-index: 72; top: max(10px, env(safe-area-inset-top)); right: max(10px, env(safe-area-inset-right)); display: flex; align-items: flex-start; gap: 6px; }
+.play-tools-bubble { flex: 0 0 auto; font-size: 13px; letter-spacing: 1px; }
+.play-utility-bubble.open .play-tools-bubble { opacity: 1; background: rgba(7,9,13,.92); }
+.play-bubble-tray {
+  display: flex; gap: 4px; padding: 4px; border: 1px solid rgba(255,255,255,.09); border-radius: 999px;
+  background: rgba(7,9,13,.76); box-shadow: 0 10px 30px rgba(0,0,0,.28); backdrop-filter: blur(12px);
+}
+.play-bubble-tray button { min-height: 30px; padding: 5px 10px; border: 0; border-radius: 999px; background: transparent; color: #bfc3ca; cursor: pointer; font-size: 9px; white-space: nowrap; }
+.play-bubble-tray button:hover { color: #fff0d4; background: rgba(197,156,91,.12); }
+.play-bubble-tray button:disabled { opacity: .35; cursor: not-allowed; }
+.immersive-table .scene-toolbar { left: auto; right: 10px; top: 58px; opacity: .45; }
+.immersive-table .scene-toolbar:hover, .immersive-table .scene-toolbar:focus-within { opacity: 1; }
+.immersive-table .play-scene-title { top: 10px; opacity: .50; transition: opacity 140ms ease; }
+.immersive-table .play-scene-title:hover { opacity: 1; }
+:fullscreen .play-workspace.immersive-table { width: 100vw; height: 100vh; }
+
+@media (max-width: 720px) {
+  .play-bubble { width: 34px; height: 34px; }
+  .play-back-bubble { top: max(7px, env(safe-area-inset-top)); left: max(7px, env(safe-area-inset-left)); }
+  .play-utility-bubble { top: max(7px, env(safe-area-inset-top)); right: max(7px, env(safe-area-inset-right)); }
+  .play-bubble-tray { flex-direction: column; border-radius: 12px; }
+  .play-bubble-tray button { text-align: left; }
+  .immersive-table .scene-toolbar { right: 7px; top: 48px; }
+  .immersive-table .play-scene-title { top: 44px; max-width: 55vw; }
+}
