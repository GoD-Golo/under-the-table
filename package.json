{
  "name": "under-the-table-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm build:libs && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "build:libs": "pnpm --filter @utt/domain build && pnpm --filter @utt/rules-dnd2024 build && pnpm --filter @utt/protocol build",
    "smoke:tokens": "tsx scripts/token-smoke.ts"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.17.43",
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "@utt/protocol": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "type": "module"
}
